# NEAR (optional; defaults to testnet + guest-book.testnet for wallet sign-in)
# NEXT_PUBLIC_NEAR_NETWORK=testnet
# NEXT_PUBLIC_NEAR_CONTRACT_ID=guest-book.testnet

# Backend API base URL (defaults to http://localhost:3001).
# Leave empty to use same-origin relative requests (e.g. with MSW mocking).
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Feature flags
# Trade demo route (/trade-demo). Off by default; 404s in production unless set.
# The demo runs on fake players and is always labelled "Demo".
# NEXT_PUBLIC_TRADE_DEMO=false

# Force the MSW browser worker on regardless of NODE_ENV (used by the E2E run).
# NEXT_PUBLIC_API_MOCKING=disabled

# ── Error tracking (Sentry) ────────────────────────────────────────────────────
# Client DSN. When unset, the app falls back to NEXT_PUBLIC_ERROR_TRACKING_ENDPOINT
# (if set), and otherwise does not report errors. Never send events from tests.
# NEXT_PUBLIC_SENTRY_DSN=
# Send events from non-production builds too (local debugging only).
# NEXT_PUBLIC_SENTRY_DEBUG=false
# Release identifier for grouping events and matching source maps.
# NEXT_PUBLIC_SENTRY_RELEASE=
# Environment label shown in Sentry (falls back to NODE_ENV).
# NEXT_PUBLIC_APP_ENV=production

# Optional plain-POST fallback endpoint for error reports (used only when no DSN).
# NEXT_PUBLIC_ERROR_TRACKING_ENDPOINT=
